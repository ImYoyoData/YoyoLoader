# Keep source and script line endings consistent across platforms.
# Without this, editing on Windows writes CRLF and shell scripts stop running on
# Linux with "/usr/bin/env: 'bash\r': No such file or directory".
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.{c,h,cpp,hpp}]
indent_size = 4
